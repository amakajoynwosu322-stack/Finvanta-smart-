rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Connectivity test collection
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Users Profile Collection
    // Enforces Phone + Password profile integrity.
    // Genuine accounts start strictly with $0 balance.
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if true;
      allow create: if isValidId(userId);
      allow update: if isValidId(userId);
      allow delete: if false;
    }

    // Phone Number Uniqueness Registry
    match /phoneRegistry/{phoneHash} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Secure Phone OTP Password Resets
    match /passwordResets/{resetId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if true;
      allow write: if true;
    }

    // Investment Plans (Public catalog)
    match /investmentPlans/{planId} {
      allow read: if true;
      allow write: if true;
    }

    // User active/past investments
    match /investments/{investmentId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Financial Ledger / Transactions
    match /transactions/{transactionId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Simulated Deposit Requests
    match /depositRequests/{requestId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Simulated Withdrawal Requests
    match /withdrawalRequests/{requestId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Referral Network
    match /referrals/{referralId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Platform Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }

    // Support Inquiries & Tickets
    match /supportTickets/{ticketId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Global Platform Settings
    match /platformConfig/{configId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
